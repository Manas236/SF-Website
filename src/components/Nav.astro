---
/* ============================================================
   Site nav: fixed bar, Services drop-down, phone drawer
   ------------------------------------------------------------
   The QMS's bar: white, a hairline at the foot, the soft shadow, the
   roundel and the wordmark painted the way the signboard paints it
   (SAMRUDDHI in red, FIRE in navy). Fixed, so every page's first band
   clears it (pt-[72px] or more).

   DESKTOP (1080px and up): Home, About, Services, Projects, Gallery,
   Contact, and the "Call Now" button. Services opens a drop-down on
   hover or keyboard focus (group-hover / group-focus-within); the panel
   unrolls and its items come in one by one (motion.css §1). Closing is
   instant. A tap on "Services" on a touch screen goes to /services.

   PHONE AND TABLET: the logo and "Call Now" stay in the bar; the links
   move into a drawer under it, toggled by the menu button, with the six
   services listed under Services.

   KEYS: `page` supplies the first segment of every key, so the same
   label has a key of its own on each page. The drawer repeats the bar's
   labels and is marked data-no-edit: the bar holds the editable copy.
   ============================================================ */
import { nav } from "../data/chrome";
import { site } from "../data/site";

interface Props {
  /** First segment of every edit key this component writes. */
  page: string;
}

const { page } = Astro.props;
const here = Astro.url.pathname.replace(/(.)\/+$/, "$1");
const isHere = (href: string) => {
  const path = href.split("#")[0];
  return here === path || (path !== "/" && here.startsWith(path + "/"));
};
const [nameHead, nameTail] = [site.name.split(" ").slice(0, -1).join(" "), site.name.split(" ").slice(-1)[0]];
const phoneIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" stroke-linejoin="round"/></svg>';
---

<header data-site-header class="fixed top-0 inset-x-0 z-50 bg-surface border-b border-border shadow-sm">
  <div class="sf-container h-[72px] flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 shrink-0 min-w-0" aria-label={nav.logoAlt}>
      <img src="/images/logo/sf-logo-96.png" alt="" width="44" height="44" class="w-11 h-11 shrink-0" />
      <span class="font-bold text-[1.05rem] tracking-[0.02em] uppercase whitespace-nowrap leading-none" data-no-edit>
        <span class="text-red">{nameHead}</span> <span class="text-navy">{nameTail}</span>
      </span>
    </a>

    <nav class="hidden min-[1080px]:flex items-center gap-7" aria-label="Primary">
      <ul class="flex items-center gap-6">
        {
          nav.links.map((link, i) => {
            const kids = "children" in link ? link.children : undefined;
            const active = isHere(link.href);
            return (
              <li class="relative group">
                <a
                  href={link.href}
                  aria-current={here === link.href ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-1.5 text-[0.95rem] font-medium py-2 border-b-2 hover:text-red",
                    active ? "text-red border-red" : "text-ink border-transparent",
                  ]}
                >
                  <span data-edit={`${page}.nav.links.${i}.label`}>{link.label}</span>
                  {kids && (
                    <svg class="w-2.5 h-2.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                      <path d="M1.5 3.5L5 7l3.5-3.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </a>
                {kids && (
                  <div class="absolute left-1/2 -translate-x-1/2 top-full pt-[18px] hidden group-hover:block group-focus-within:block">
                    <ul class="sf-nav-menu min-w-[270px] bg-surface border border-border rounded-card p-2 shadow-md">
                      {kids.map((kid, j) => (
                        <li>
                          <a href={kid.href} class="block rounded-button px-4 py-2.5 text-[0.93rem] text-ink whitespace-nowrap hover:bg-red-light hover:text-red">
                            <span data-edit={`${page}.nav.services.${j}`}>{kid.label}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>

      <a href={nav.cta.href} class="sf-btn sf-btn-primary">
        <Fragment set:html={phoneIcon} />
        <span data-edit={`${page}.nav.cta`}>{nav.cta.label}</span>
      </a>
    </nav>

    <div class="flex items-center gap-2 min-[1080px]:hidden">
      <a href={nav.cta.href} class="sf-btn sf-btn-primary !px-3.5 !text-[0.9rem]" aria-label={`${nav.cta.label}: ${site.phone.display}`}>
        <Fragment set:html={phoneIcon} />
        <span data-no-edit class="max-[399px]:hidden">{nav.cta.label}</span>
      </a>
      <button
        type="button"
        id="nav-drawer-toggle"
        class="inline-flex items-center justify-center w-11 h-11 -mr-2 rounded-button text-navy hover:bg-navy-light"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Open menu"
      >
        <svg id="nav-drawer-icon-open" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" /></svg>
        <svg id="nav-drawer-icon-close" class="hidden w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <nav id="nav-drawer" class="hidden min-[1080px]:hidden border-t border-border bg-surface max-h-[calc(100dvh-72px)] overflow-y-auto" aria-label="Primary, mobile">
    <ul class="sf-container flex flex-col py-3">
      {
        nav.links.map((link) => {
          const kids = "children" in link ? link.children : undefined;
          const active = isHere(link.href);
          return (
            <li class="border-b border-border last:border-b-0">
              <a href={link.href} aria-current={here === link.href ? "page" : undefined} class:list={["block py-3.5 text-[1.05rem] font-semibold", active ? "text-red" : "text-navy"]}>
                <span data-no-edit>{link.label}</span>
              </a>
              {kids && (
                <ul class="flex flex-col pb-3 pl-4 ml-1 mb-3 border-l-2 border-red">
                  {kids.map((kid) => (
                    <li>
                      <a href={kid.href} class="block py-2.5 text-[0.98rem] text-ink hover:text-red">
                        <span data-no-edit>{kid.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-drawer-toggle");
  const drawer = document.getElementById("nav-drawer");
  const iconOpen = document.getElementById("nav-drawer-icon-open");
  const iconClose = document.getElementById("nav-drawer-icon-close");

  /* The drawer's links come in one after another (motion.css §1): each
     gets its place in the run the first time the drawer opens. */
  let numbered = false;

  const setOpen = (open: boolean) => {
    if (open && !numbered && drawer) {
      drawer.querySelectorAll("a").forEach((a, i) => a.style.setProperty("--sf-i", String(i)));
      numbered = true;
    }
    drawer?.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };

  toggle?.addEventListener("click", () => setOpen(drawer?.classList.contains("hidden") ?? false));

  drawer?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && drawer && !drawer.classList.contains("hidden")) {
      setOpen(false);
      toggle?.focus();
    }
  });

  /* Back to the desktop bar: never leave a drawer open behind it. */
  matchMedia("(min-width: 1080px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
