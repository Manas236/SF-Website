---
/* ============================================================
   GET /studio/leads: contact-form enquiries, newest first
   ------------------------------------------------------------
   Read-only. Every enquiry is saved to `leads` before any email is
   tried, so this list is complete even while email is off (SMTP_HOST
   empty) or failing. Each row says what happened to its email copy
   (lead_emails).

   SIGNED-IN EDITORS ONLY: anyone else gets the same bodyless 404 as a
   wrong sign-in slug. Not indexed, never cached. Astro escapes every
   value, so a message cannot inject markup.
   ============================================================ */
import type { RowDataPacket } from "mysql2";
import BaseLayout from "../../layouts/BaseLayout.astro";
import pool from "../../lib/db";
import { isAuthed } from "../../lib/edit-auth";
import { mailConfigured } from "../../lib/mailer";
import { site } from "../../data/site";

export const prerender = false;

if (!isAuthed(Astro.request)) {
  return new Response(null, { status: 404, headers: { "X-Astro-Error": "true" } });
}

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "no-store");

const LIMIT = 200;
let rows: RowDataPacket[] = [];
let failed = false;
try {
  [rows] = await pool.execute<RowDataPacket[]>(
    `SELECT l.id, l.name, l.phone, l.email, l.service, l.message, l.created_at,
            (SELECT e.outcome FROM lead_emails e WHERE e.lead_id = l.id ORDER BY e.id DESC LIMIT 1) AS mail
       FROM leads l
      ORDER BY l.id DESC
      LIMIT ${LIMIT}`
  );
} catch (err) {
  console.error("Failed to read leads:", err);
  failed = true;
}

const when = (d: unknown) =>
  d instanceof Date
    ? d.toLocaleString("en-IN", { timeZone: "Asia/Kolkata", day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" })
    : String(d ?? "");
const mailLabel: Record<string, string> = { sent: "Emailed", failed: "Email failed", disabled: "Email off" };
---

<BaseLayout page="Enquiries" description="Contact-form enquiries." noindex>
  <main class="min-h-screen bg-canvas px-5 py-10 sm:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="sf-pill">{site.name} studio</span>
          <h1 class="mt-3 text-[1.8rem] font-bold">Enquiries</h1>
          <p class="mt-1 text-muted">
            From the contact form, newest first. Email copies are {mailConfigured() ? "on" : "off (SMTP_HOST is empty), so this list is the only copy"}.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/" class="sf-btn sf-btn-ghost">Go to the site</a>
          <a href="/studio/gallery" class="sf-btn sf-btn-ghost">Manage photos</a>
        </div>
      </div>

      {failed && <p class="mt-8 sf-card p-5 font-semibold text-red" role="alert">Could not read the enquiries. Try again in a moment.</p>}
      {!failed && rows.length === 0 && <p class="mt-8 sf-card p-5 text-muted">No enquiries yet.</p>}

      <ol class="mt-8 grid gap-4">
        {
          rows.map((r) => (
            <li class="sf-card p-5 sm:p-6" data-lead={r.id}>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <p class="text-[1.1rem] font-bold text-navy">{r.name}</p>
                <p class="text-[0.85rem] text-muted">{when(r.created_at)} &middot; {mailLabel[r.mail as string] ?? "Email pending"}</p>
              </div>
              <p class="mt-1 text-[0.95rem]">
                <a href={`tel:${String(r.phone).replace(/[^\d+]/g, "")}`} class="font-semibold text-red">{r.phone}</a>
                {r.email && <span> &middot; <a href={`mailto:${r.email}`} class="text-navy underline">{r.email}</a></span>}
                <span class="text-muted"> &middot; {r.service}</span>
              </p>
              <p class="mt-3 whitespace-pre-line text-ink">{r.message}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</BaseLayout>
