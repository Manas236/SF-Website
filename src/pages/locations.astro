---
/* ============================================================
   /locations: service areas
   ------------------------------------------------------------
   The three verified areas only (src/data/site.ts), the office with a
   live map, and a photo slot (locations.photo). Linked from the footer
   and the contact page, not from the main nav.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import T from "../components/T.astro";
import SlotPhoto from "../components/SlotPhoto.astro";
import CtaBand from "../components/CtaBand.astro";
import { locationsPage as copy } from "../data/locations-page";
import { directionsUrl, mapEmbedUrl, site } from "../data/site";
import { icons } from "../data/icons";
import { liveState } from "../lib/gallery-live";

export const prerender = false;

const page = "locations";
const live = await liveState();
const { areas, office } = copy;
---

<BaseLayout page={copy.meta.title} description={copy.meta.description}>
  <Nav page={page} />
  <main>
    <PageHero page={page} {...copy.hero} />

    <section class="bg-surface py-16 sm:py-24">
      <div class="sf-container">
        <div class="max-w-2xl">
          <T as="p" k={`${page}.areas.kicker`} text={areas.kicker} class="sf-pill" />
          <T as="h2" k={`${page}.areas.heading`} text={areas.heading} class="mt-3 text-[clamp(1.6rem,3.6vw,2.25rem)] font-bold" />
        </div>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-10">
          {
            areas.items.map((a, i) => (
              <li class="sf-card relative overflow-hidden p-7" data-card>
                <span class="sf-icon"><Fragment set:html={icons.pin} /></span>
                <T as="h3" k={`${page}.areas.items.${i}.name`} text={a.name} class="mt-5 text-[1.3rem] font-bold" />
                <T as="p" k={`${page}.areas.items.${i}.text`} text={a.text} class="mt-2 text-muted" />
              </li>
            ))
          }
        </ul>
        <T as="p" k={`${page}.areas.note`} text={areas.note} class="mt-8 text-[1.05rem] text-ink" />
      </div>
    </section>

    <section class="bg-canvas py-16 sm:py-24">
      <div class="sf-container grid gap-10 lg:grid-cols-2 lg:gap-14 items-start">
        <div>
          <T as="p" k={`${page}.office.kicker`} text={office.kicker} class="sf-pill" />
          <T as="h2" k={`${page}.office.heading`} text={office.heading} class="mt-3 text-[clamp(1.6rem,3.6vw,2.25rem)] font-bold" />
          <address class="not-italic mt-5 text-[1.05rem] text-ink" data-no-edit>
            <span class="block font-semibold text-navy">{site.name}</span>
            {site.address.lines.map((l) => <span class="block">{l}</span>)}
          </address>
          <p class="mt-4 text-ink">
            <T k={`${page}.office.hoursLabel`} text={office.hoursLabel} class="text-muted" />
            <span data-no-edit>: {site.hours.display}</span>
          </p>
          <a href={directionsUrl} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-1.5 font-semibold text-red hover:text-red-dark">
            <T k={`${page}.office.directions`} text={office.directions} />
            <span data-arrow aria-hidden="true">&rarr;</span>
          </a>
          <div class="relative aspect-[3/2] overflow-hidden rounded-card bg-border shadow-md mt-8">
            <SlotPhoto state={live} slot="locations.photo" sizes="(min-width: 1024px) 560px, 100vw" pictureClass="absolute inset-0" class="w-full h-full object-cover" />
          </div>
        </div>
        <div class="relative aspect-[4/5] sm:aspect-[4/3] lg:aspect-[4/5] overflow-hidden rounded-card border border-border bg-surface shadow-sm">
          <iframe src={mapEmbedUrl} title={office.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="absolute inset-0 w-full h-full border-0"></iframe>
        </div>
      </div>
    </section>

    <CtaBand page={page} />
  </main>
  <SiteFooter page={page} />
</BaseLayout>
