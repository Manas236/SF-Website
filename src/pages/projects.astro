---
/* ============================================================
   /projects: ongoing and completed
   ------------------------------------------------------------
   The two lists are project text blocks (src/lib/project-blocks.ts),
   added by a signed-in editor in edit mode: a heading per project and
   descriptions under it. While BOTH lists are empty, visitors see one
   designed "Projects coming soon" panel; the list headings and the
   editor's "Add to this list" cards still render, shown only in edit
   mode (.sf-edit-only in public/editor-ui.css). Once either list has
   entries, both lists show, an empty one with a one-line note.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import T from "../components/T.astro";
import ProjectList from "../components/ProjectList.astro";
import CtaBand from "../components/CtaBand.astro";
import { projectsPage as copy } from "../data/projects-page";
import { site, telHref } from "../data/site";
import { icons } from "../data/icons";
import { PROJECT_LISTS, blocksFor } from "../lib/project-blocks";

export const prerender = false;

const page = "projects";
const lists = await Promise.all(PROJECT_LISTS.map(async (slug) => ({ slug, blocks: await blocksFor(slug) })));
const allEmpty = lists.every((l) => l.blocks.length === 0);
---

<BaseLayout page={copy.meta.title} description={copy.meta.description}>
  <Nav page={page} />
  <main>
    <PageHero page={page} {...copy.hero} />

    {
      allEmpty && (
        <section class="bg-canvas pt-16 sm:pt-24 pb-4">
          <div class="sf-container">
            <div class="sf-card relative overflow-hidden px-6 py-12 sm:px-12 sm:py-16 text-center">
              <span class="absolute inset-x-0 top-0 h-[3px] bg-red" aria-hidden="true" />
              <span class="absolute -left-20 -bottom-24 w-64 h-64 rounded-full border-[24px] border-navy-light" aria-hidden="true" />
              <span class="absolute -right-16 -top-20 w-52 h-52 rounded-full border-[20px] border-red-light" aria-hidden="true" />
              <div class="relative mx-auto max-w-xl">
                <span class="sf-icon mx-auto">
                  <Fragment set:html={icons.building} />
                </span>
                <T as="h2" k={`${page}.empty.title`} text={copy.empty.title} class="mt-6 text-[clamp(1.6rem,3.6vw,2.2rem)] font-bold" />
                <T as="p" k={`${page}.empty.text`} text={copy.empty.text} class="mt-4 text-[1.05rem] text-muted" />
                <div class="mt-8 flex flex-wrap justify-center gap-3">
                  <a href={telHref} class="sf-btn sf-btn-primary" aria-label={`${copy.empty.call}: ${site.phone.display}`}>
                    <Fragment set:html={icons.phone} />
                    <T k={`${page}.empty.call`} text={copy.empty.call} />
                  </a>
                  <a href={site.whatsapp.href} target="_blank" rel="noopener" class="sf-btn sf-btn-navy">
                    <Fragment set:html={icons.whatsapp} />
                    <T k={`${page}.empty.whatsapp`} text={copy.empty.whatsapp} />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section class:list={["bg-canvas", allEmpty ? "pb-4" : "py-16 sm:py-24"]}>
      <div class="sf-container grid gap-14">
        {
          lists.map(({ slug, blocks }) => {
            const c = copy.lists[slug];
            return (
              <div class:list={[allEmpty && "sf-edit-only"]}>
                <T as="h2" k={`${page}.lists.${slug}.heading`} text={c.heading} class="text-[clamp(1.4rem,3vw,1.9rem)] font-bold" />
                <div class="mt-6">
                  <ProjectList slug={slug} blocks={blocks}>
                    <T slot="empty" as="p" k={`${page}.lists.${slug}.empty`} text={c.empty} class="text-muted" />
                  </ProjectList>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <CtaBand page={page} />
  </main>
  <SiteFooter page={page} />
</BaseLayout>
