# ============================================================
# Samruddhi Fire website: environment
# ------------------------------------------------------------
# Copy this file to ".env" and fill in real values. .env holds secrets
# and is git-ignored. Never commit it.
# ============================================================

# Dev server port. 4321 and 4322 are used by other projects on this machine.
PORT=4323

# Absolute origin for every canonical URL, og:image, the JSON-LD, the
# sitemap and the Sitemap line in /robots.txt. Empty in development falls
# back to http://localhost:<PORT>. REQUIRED on the real domain:
# `npm run build:release` refuses to build while it is empty, http, or
# localhost. Origin only, no path, no trailing slash, e.g.
# https://www.example.in
PUBLIC_SITE_URL=

# Keep this copy of the site out of search engines. 1 (the default while
# the site is in review) adds X-Robots-Tag: noindex, nofollow to every
# response, a robots meta tag to every page, and makes /robots.txt
# disallow everything. Read at request time: edit and restart, no
# rebuild. Set it to 0 (or remove it) on the real domain at launch.
SITE_NOINDEX=1

# ============================================================
# MySQL
# ------------------------------------------------------------
# db/migrate.sql creates the database and every table; an administrator
# runs it on every deploy. DB_USER (sf_site) may only SELECT and INSERT;
# the app never changes the schema. The grants are at the foot of
# db/migrate.sql.
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=sf_site
DB_PASSWORD=
DB_NAME=sf_site

# ============================================================
# In-page editor sign-in
# ------------------------------------------------------------
# All three are REQUIRED. src/lib/edit-auth.ts throws at import time if
# EDIT_SECRET is missing. Generate each with, for example:
#   node -e "console.log(require('crypto').randomBytes(30).toString('base64url'))"
# ============================================================

# The secret path segment: the editor signs in at /studio/<slug>.
# Long and random, not a word. Nothing links to it.
EDIT_LOGIN_SLUG=

# What the editor types into the box. This is the real protection.
EDIT_PASSPHRASE=

# HMAC key for the seven-day session cookie. Changing this or
# EDIT_PASSPHRASE signs everybody out.
EDIT_SECRET=

# Studio photo uploads are stored here (MEDIA_DIR/gallery). Outside the
# repo and dist/ so deploys never touch them; back this folder up.
# Empty falls back to ./media for local development.
MEDIA_DIR=

# ============================================================
# Contact form email (src/lib/mailer.ts)
# ------------------------------------------------------------
# Every enquiry is saved to the `leads` table first. If SMTP_HOST is
# set, a copy is also emailed to LEADS_TO. With SMTP_HOST empty the
# email is skipped, the server log says "email disabled", and the
# visitor still sees the success message. For Gmail use smtp.gmail.com,
# port 465, the full address as SMTP_USER and an App Password (Google
# Account, Security, 2-Step Verification, App passwords) as SMTP_PASS.
# Read at request time: edit and restart, no rebuild.
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The From address. Empty means SMTP_USER.
SMTP_FROM=
LEADS_TO=samruddhifire@gmail.com
